# Copy to .env and adjust to match your host:
#     cp .env.example .env

# Must match your host user, or the bind-mounted workspace is read-only in the
# container. Note ${UID}/${GID} cannot be used directly in compose: bash does not
# export UID, and GID does not exist at all.
LOCAL_UID=1000
LOCAL_GID=1000

# Name of the user inside the container. Deliberately NOT called USERNAME:
# many desktop sessions export USERNAME, and compose gives the shell environment
# precedence over this file, so a variable by that name would be silently
# overridden by your host login name.
# Keep this as "admin" unless you also change the Dockerfile: it hardcodes
# /home/admin for WORKDIR and VIRTUAL_ENV, which the compose cache paths follow.
CONTAINER_USER=admin

# Absolute path to the host workspace. Only its src/ is mounted, which is what
# keeps the Isaac Sim venv inside colcon_ws alive (see README.md).
HOST_WS=/home/ipa326/workspace/ros_ws/fullbody/colcon_rox_ws

TZ=Europe/Berlin
