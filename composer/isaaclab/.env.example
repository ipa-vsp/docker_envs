# Copy to .env next to compose.yml and adjust.
# Export LOCAL_UID="$(id -u)" LOCAL_GID="$(id -g)" in the shell (Compose does not run commands).
IMAGE=docker_envs:24.04-jazzy-isaacsim6.1.0.0-isaaclabrelease-3.0.0-python-env
HOST_WS=/absolute/path/to/colcon_ws
CONTAINER_NAME=isaaclab
CONTAINER_USER=admin
WORKSPACE_UMASK=0022
# Only for compose.x11.yml:
# XAUTH_DIR=/run/user/1000/docker-envs-xauth-1000
