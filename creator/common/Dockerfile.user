# syntax=docker/dockerfile:1
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Dependencies precede personalized account metadata for cache sharing.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git libstdc++6 sudo && \
    rm -rf /var/lib/apt/lists/* && apt-get clean

# Node.js for the npm-distributed agent tools (REA, OmniRoute) installed below.
ARG NODE_MAJOR=24
RUN --mount=type=bind,source=creator/common/install_node.sh,target=/tmp/install_node.sh \
    NODE_MAJOR=${NODE_MAJOR} bash /tmp/install_node.sh

# No Python environment is created here. /opt/venv (with VIRTUAL_ENV and PATH)
# is inherited from Dockerfile.venv, which the build plan adds only for MuJoCo,
# Isaac Sim, Isaac Lab or cuRobo. Pure ROS images, including CI, use the
# system Python.

ARG USERNAME=admin
ARG USER_UID=1000
ARG USER_GID=1000
ARG ROS_DISTRO=""
RUN --mount=type=bind,source=creator/common/create_user.sh,target=/tmp/create_user.sh \
    --mount=type=bind,source=creator/common/isaac-cache-dirs.txt,target=/tmp/isaac-cache-dirs.txt \
    ISAAC_CACHE_LIST=/tmp/isaac-cache-dirs.txt bash /tmp/create_user.sh

ENV USERNAME=${USERNAME} USER_UID=${USER_UID} USER_GID=${USER_GID}
ENV HOME=/home/${USERNAME} ROS_DISTRO=${ROS_DISTRO}
ENV PATH=/home/${USERNAME}/.local/bin:${PATH}
COPY --chmod=0755 creator/scripts/workspace-entrypoint.sh /usr/local/bin/scripts/workspace-entrypoint.sh

USER ${USERNAME}
# The home, not a workspace: the image ships no colcon_ws (see create_user.sh).
WORKDIR /home/${USERNAME}
# Install into the development user's home, with pipefail propagating download errors.
RUN curl -fsSL https://claude.ai/install.sh | bash
# Shared skills/agents/rules go into the user-level ~/.claude, so a workspace
# mounted at ~/colcon_ws cannot hide them. ~/.claude may already hold Claude's
# own state, so check the repository out over it instead of cloning into it.
RUN claude --version && \
    if [[ ! -d .claude/.git ]]; then \
        git clone --no-checkout https://github.com/ipa-vsp/.claude.git /tmp/dot-claude && \
        mkdir -p .claude && mv /tmp/dot-claude/.git .claude/.git && rm -rf /tmp/dot-claude && \
        git -C .claude reset --hard --quiet HEAD; \
    fi

# Plugins come after the ~/.claude checkout so it cannot reset their state.
# Each --marketplace source is added to the user settings on first use.
RUN claude plugin install claude-code-setup --marketplace anthropics/claude-plugins-official && \
    claude plugin install security-guidance --marketplace anthropics/claude-plugins-official && \
    claude plugin install caveman --marketplace JuliusBrussee/caveman && \
    claude plugin list

# Global npm packages go into the account's ~/.local (already on PATH), so
# `rea update` and later `npm install --global` need no root.
ENV NPM_CONFIG_PREFIX=/home/${USERNAME}/.local
# REA registers its MCP server in ~/.claude.json and its skill in ~/.claude.
# OmniRoute is only installed: it is a local gateway that needs its own
# secrets, so Claude Code is not pointed at it here (see creator/README.md).
RUN npm install --global --no-fund --no-audit rea-agents omniroute && \
    rea setup --yes --client claude_code && \
    rea --version && command -v omniroute && \
    npm cache clean --force

# Graphify goes into the shared environment when there is one (owned by the
# account by now); pure ROS images get it as an isolated uv tool in ~/.local.
RUN if ! command -v uv >/dev/null 2>&1; then \
        curl -LsSf https://astral.sh/uv/install.sh \
            | env UV_UNMANAGED_INSTALL="$HOME/.local/bin" sh; \
    fi && \
    if [[ -n "${VIRTUAL_ENV:-}" && -x "${VIRTUAL_ENV}/bin/python" ]]; then \
        uv pip install --python "${VIRTUAL_ENV}/bin/python" graphifyy; \
    else \
        uv tool install graphifyy; \
    fi && \
    graphify install && \
    graphify --version

# Append the interactive banner without replacing ROS/Isaac shell setup.
USER root
COPY --chmod=0644 creator/scripts/container-banner.bash /etc/docker-envs-banner.bash
RUN banner_source='source /etc/docker-envs-banner.bash'; \
    grep -Fxq "$banner_source" /etc/bash.bashrc || \
    printf '\n%s\n' "$banner_source" >> /etc/bash.bashrc
USER ${USERNAME}
ENTRYPOINT ["/usr/local/bin/scripts/workspace-entrypoint.sh"]
CMD ["/bin/bash"]
