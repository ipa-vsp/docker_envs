# syntax=docker/dockerfile:1
# MuJoCo layer.
#
# Installs both the native MuJoCo distribution (headers/libs under /opt/mujoco)
# and the Python bindings. MUJOCO_VERSION is resolved from the GitHub releases
# API by creator/scripts/lib/stages.sh, so the local build can always pick up
# the newest release without editing this file.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG MUJOCO_VERSION=3.12.0
ARG GYM_VERSION=1.3.0
ARG CPU_ARCH=x86_64

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libglfw3-dev python3-pip python3-venv wget \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Native MuJoCo distribution
ENV MUJOCO_VERSION=${MUJOCO_VERSION}
ENV MUJOCO_DIR="/opt/mujoco/mujoco-${MUJOCO_VERSION}"
RUN mkdir -p "$(dirname "${MUJOCO_DIR}")" \
    && wget -q -O /tmp/mujoco.tar.gz \
        "https://github.com/google-deepmind/mujoco/releases/download/${MUJOCO_VERSION}/mujoco-${MUJOCO_VERSION}-linux-${CPU_ARCH}.tar.gz" \
    && tar -xzf /tmp/mujoco.tar.gz -C "$(dirname "${MUJOCO_DIR}")" \
    && rm -f /tmp/mujoco.tar.gz

ENV LD_LIBRARY_PATH="${MUJOCO_DIR}/lib:${LD_LIBRARY_PATH:-}"

# Python bindings go into the shared environment created by Dockerfile.venv.
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    test -x "${VIRTUAL_ENV:-}/bin/python" \
    && uv pip install --python "${VIRTUAL_ENV}/bin/python" \
        "mujoco==${MUJOCO_VERSION}" \
        "gymnasium==${GYM_VERSION}"
