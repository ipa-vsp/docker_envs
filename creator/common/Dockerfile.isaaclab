# syntax=docker/dockerfile:1
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl cmake git build-essential \
        libgl1-mesa-dev libx11-dev libxcursor-dev libxi-dev libxinerama-dev libxrandr-dev \
    && rm -rf /var/lib/apt/lists/* && apt-get clean

ARG ISAACLAB_VERSION=release/3.0.0
# Both installation methods install into the shared /opt/venv (Dockerfile.venv).
ARG ISAACLAB_METHOD=python-env
ARG ISAACLAB_INSTALL=default
ARG ISAACLAB_DIR=/opt/IsaacLab
ENV ISAACLAB_DIR=${ISAACLAB_DIR} ISAACLAB_VERSION=${ISAACLAB_VERSION}
ENV ISAACLAB_METHOD=${ISAACLAB_METHOD} ISAACLAB_INSTALL=${ISAACLAB_INSTALL}
ENV ISAAC_VENV=${VIRTUAL_ENV}
ENV OMNI_KIT_ACCEPT_EULA=YES

RUN git clone --depth 1 --branch "${ISAACLAB_VERSION}" \
        https://github.com/isaac-sim/IsaacLab.git "${ISAACLAB_DIR}"
RUN --mount=type=cache,id=creator-isaaclab-pip,target=/root/.cache/pip,sharing=locked \
    --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    --mount=type=bind,source=creator/common/install_isaaclab.sh,target=/tmp/install_isaaclab.sh \
    UV_CACHE_DIR=/root/.cache/uv bash /tmp/install_isaaclab.sh

# Convenience aliases for interactive use.
RUN printf '\nalias isaac-activate="source %s/bin/activate"\nalias isaaclab="%s/isaaclab.sh"\n' \
        "${ISAAC_VENV}" "${ISAACLAB_DIR}" >> /etc/bash.bashrc
