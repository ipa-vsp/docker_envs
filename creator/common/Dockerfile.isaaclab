# syntax=docker/dockerfile:1
# NVIDIA Isaac Lab layer.
#
# Builds on the Isaac Sim layer: Isaac Lab's extensions are installed into the
# same /opt/isaac-venv interpreter that carries the isaacsim wheels.
#
# ISAACLAB_VERSION is any ref `git clone --branch` accepts: a tag (v2.3.2) or a
# branch ("main"/"develop" track development, "release/3.0.0" a release line).
# Both lists are read from GitHub by creator/scripts/lib/stages.sh.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG ISAACLAB_VERSION=v2.3.2
# Value passed to `isaaclab.sh --install`. The vocabulary differs by Isaac Lab
# major version (2.x: none/all/rsl_rl/...; 3.x: core/all/rl[rsl-rl]/...), so
# stages::isaaclab_install_arg translates the user's choice before it gets here.
ARG ISAACLAB_INSTALL=core
ARG ISAACLAB_DIR=/opt/IsaacLab
ARG ISAAC_VENV=/opt/isaac-venv

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
        cmake git build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

ENV ISAACLAB_DIR=${ISAACLAB_DIR}
ENV ISAACLAB_VERSION=${ISAACLAB_VERSION}
ENV OMNI_KIT_ACCEPT_EULA=YES

RUN git clone --depth 1 --branch "${ISAACLAB_VERSION}" \
        https://github.com/isaac-sim/IsaacLab.git "${ISAACLAB_DIR}"

# isaaclab.sh picks its interpreter from the active virtualenv, so activate the
# Isaac Sim venv before handing over. Without it the installer would target the
# distro python, which has no isaacsim wheels.
RUN --mount=type=cache,id=creator-isaaclab-pip,target=/root/.cache/pip,sharing=locked \
    --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    source "${ISAAC_VENV}/bin/activate" \
    && cd "${ISAACLAB_DIR}" \
    && ./isaaclab.sh --install "${ISAACLAB_INSTALL}"

# Same reasoning as the Isaac Sim layer: keep the Isaac interpreter off the
# default PATH and expose an opt-in helper instead.
RUN printf '\nalias isaaclab="%s/isaaclab.sh"\n' "${ISAACLAB_DIR}" \
        >> /etc/bash.bashrc
