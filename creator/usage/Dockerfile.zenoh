# syntax=docker/dockerfile:1
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV RMW_IMPLEMENTATION=rmw_zenoh_cpp

# Install dependencies, build tools, and Zenoh
RUN apt-get update -qq && \
    apt-get install -y \
    git \
    python3-rosdep \
    python3-colcon-common-extensions \
    build-essential \
    cmake && \
    rm -rf /var/lib/apt/lists/*

# Initialize and update rosdep
RUN rosdep update

# Only the installed workspace survives this instruction. Deleting build inputs
# in a later RUN would leave their bytes in historical layers.
# Upstream's default branch tracks Rolling and may require newer ROS APIs.
# CMake would otherwise pick the /opt/venv interpreter from VIRTUAL_ENV.
ARG ZENOH_REF=${ROS_DISTRO}
RUN --mount=type=cache,id=creator-zenoh-cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=creator-zenoh-cargo-git,target=/root/.cargo/git,sharing=locked \
    mkdir -p /home/ws_rmw_zenoh/src \
    && git clone --branch "${ZENOH_REF}" https://github.com/ros2/rmw_zenoh.git /home/ws_rmw_zenoh/src/rmw_zenoh \
    && cd /home/ws_rmw_zenoh \
    && apt-get update -qq \
    && rosdep install --from-paths src --ignore-src --rosdistro ${ROS_DISTRO} -y \
    && /bin/bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release -DPython3_EXECUTABLE=/usr/bin/python3" \
    && rm -rf src build log /var/lib/apt/lists/* \
    && apt-get clean
